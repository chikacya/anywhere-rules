# Spotify 与 DualSubs - Anywhere MITM RuleSet
# 上游: app2smile/rules、DualSubs/Spotify、DualSubs/Universal、本地Spotify广告位清理。

name = Spotify 与 DualSubs
icon-light = 
hostname = spclient.wg.spotify.com, spclient.spotify.com, spotify.com

[Parameter]
0, 0, subtitle_target_language, 歌词目标语言, 例如zh-CN简体或zh-TW繁体及en英语, zh-CN
1, 0, translation_vendor, 翻译引擎, 商业引擎需填写对应认证, Google, "[Google, GoogleCloud, Microsoft, DeepL]"
1, 0, translation_attempts, 翻译尝试次数, 包括首次请求最多4次；立即重试且总请求最多16次, 4, "[1, 2, 3, 4]"
1, 0, googlecloud_version, Google Cloud版本, v3需要项目ID及OAuth Token, v2, "[v2, v3]"
1, 0, googlecloud_mode, Google Cloud v2认证, 仅v2使用此选项；v3使用OAuth Token, Key, "[Key, Token]"
0, 0, googlecloud_auth, Google Cloud认证, 填入v2 Key或OAuth Token, 
0, 0, googlecloud_project, Google Cloud项目ID, v3必填, 
1, 0, microsoft_version, Microsoft服务, 选择区域服务端, Azure, "[Azure, AzureCN, AzureUS]"
1, 0, microsoft_mode, Microsoft认证方式, 选择Key或Bearer Token, Key, "[Key, Token]"
0, 0, microsoft_auth, Microsoft认证, 对应Key或Token, 
0, 0, microsoft_region, Microsoft区域, Key认证的订阅区域, global
1, 0, deepl_version, DeepL服务, 选择Free或Pro, Free, "[Free, Pro]"
0, 0, deepl_auth, DeepL Key, 填写DeepL认证Key, 
1, 0, spotify_json_client, JSON歌词客户端, iOS使用原生译文轨道；Web客户端将原文和译文逐行交错显示, iOS, "[iOS, Web]"
1, 0, lyrics_diagnostics, 歌词诊断日志, 只记录格式行数及错误类别，不记录歌词或凭据, false, "[false, true]"

[Rule]
0, 2, ^https://[^/]+/user-customization-service/v1/customize(?:\?|$), if-none-match
0, 0, ^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:pendragon/|ad(?:[/?]|$)), 2, {}
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://((?:(?!platform=iphone).)*?)com:443(.*?)platform=iphone(.*)$, 0, https://$1com$2platform=ipad$3
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://(.*?)platform=iphone(.*?)com:443(.*)$, 0, https://$1platform=ipad$2com$3
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://(.*?)platform=iphone(.*)$, 0, https://$1platform=ipad$2
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://(.*?)com:443(.*)$, 0, https://$1com$2
1, 100, ^https://[^/]+/(?:bootstrap/v1/bootstrap|user-customization-service/v1/customize)(?:\?|$), 
1, 100, ^https://(?:[^/]+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:ads/v3/ads|casita/v1/home/default|scrollsita/v1/scroll/[^/?#]+)(?:\?|$), 
1, 100, ^https?://(?:[^/]+-spclient|spclient\.wg)\.spotify\.com(?::443)?/color-lyrics/v2/track/[^/?#]+\?, 

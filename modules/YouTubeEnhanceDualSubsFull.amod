[Module]
name = YouTube Enhance 与 DualSubs
description = 来源：@gholts · @VirgilClyne · @chikacya ｜ 净化 YouTube 广告，增强播放体验，提供双语字幕与 Music 歌词翻译。 可选 Google、DeepL 等翻译引擎，配置字幕模式、顺序与播放增强。 ｜ 补齐预览广告清理与 Music 歌词翻译，修复歌曲信息，减少重复翻译和无效播放处理。
icon-light = 

[MITM]
# YouTube Enhance 与 DualSubs - Anywhere MITM RuleSet
# 上游: gholts/surge、DualSubs/YouTube、DualSubs/Universal、DualSubs/WebVTT、NSNanoCat/XML。

name = YouTube Enhance 与 DualSubs 完整功能
hostname = googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, tv.youtube.com, s.youtube.com, music.youtube.com

[Parameter]
1, 0, blockUpload, 隐藏上传入口, 隐藏导航中的上传入口, true, "[true, false]"
1, 0, blockShorts, 隐藏Shorts入口, 隐藏导航中的Shorts入口, false, "[true, false]"
1, 0, autoHd, 自动高清, 优先最高可用视频清晰度并防止自动降级, true, "[true, false]"
1, 0, blockGames, 隐藏游戏推荐, 隐藏Playables游戏推荐卡片, true, "[true, false]"
1, 0, blockVerticalLive, 隐藏竖屏直播, 隐藏已识别的竖屏直播推荐, false, "[true, false]"
1, 0, jumpAhead, 启用Jump Ahead, 启用原生跳过按钮并去除推广提示, true, "[true, false]"
1, 0, blockStore, 隐藏商店与购物, 隐藏创作者商店和视频购物组件, true, "[true, false]"
1, 0, blockAi, 隐藏AI功能, 隐藏Ask和AI摘要等控件, true, "[true, false]"
1, 0, subtitle_type, [字幕] 启用类型, 请选择要使用的字幕，双语字幕将使用您选择类型呈现。, Translate, "[Translate, Official, External]"
1, 0, auto_cc, [字幕] 自动显示, 是否总是自动开启字幕显示。, true, "[true, false]"
1, 0, show_only_auto_translation, [翻译器] 只显示自动翻译字幕, 是否仅显示自动翻译字幕，不显示源语言字幕。, false, "[false, true]"
1, 0, subtitle_diagnostics, 字幕诊断日志, 测试期每阶段15秒最多一条，不记录字幕或凭据, true, "[true, false]"
0, 0, subtitle_cache_size, 字幕缓存数量, 0关闭；最多100个结果，歌词缓存另限128KiB；容量不足清理各自旧结果, 20
0, 0, subtitle_source_language, 原文语言, auto从字幕请求读取语言；例如en或zh-CN, auto
0, 0, subtitle_target_language, 默认目标语言, 字幕请求已选语言优先；例如zh-CN或en, zh-CN
1, 0, subtitle_position, 字幕顺序, 原文在前或译文在前, Forward, "[Forward, Reverse]"
0, 0, subtitle_tolerance_ms, 合成时间容差, 官方或外挂字幕对齐容差；0至5000毫秒, 100
0, 0, subtitle_offset_ms, 副轨时间偏移, 正值延后副轨；范围负60000至60000毫秒, 0
1, 0, translation_vendor, 翻译引擎, 商业引擎需填写对应认证, Google, "[Google, GoogleCloud, Microsoft, DeepL]"
1, 0, translation_attempts, 翻译尝试次数, 包括首次请求最多4次；立即重试且总请求最多16次, 4, "[1, 2, 3, 4]"
1, 0, googlecloud_version, Google Cloud版本, v3需要项目ID及OAuth Token, v2, "[v2, v3]"
1, 0, googlecloud_mode, Google Cloud v2认证, 仅v2使用此选项；v3使用OAuth Token, Key, "[Key, Token]"
0, 0, googlecloud_auth, Google Cloud认证, 填入v2 Key或OAuth Token, 
0, 0, googlecloud_project, Google Cloud项目ID, v3必填, 
1, 0, microsoft_version, Microsoft服务, 选择区域服务端, Azure, "[Azure, AzureCN, AzureUS]"
1, 0, microsoft_mode, Microsoft认证方式, 选择Key或Bearer Token, Key, "[Key, Token]"
0, 0, microsoft_auth, Microsoft认证, 对应Key或Token, 
0, 0, microsoft_region, Microsoft区域, Key认证的订阅区域, global
1, 0, deepl_version, DeepL服务, 选择Free或Pro, Free, "[Free, Pro]"
0, 0, deepl_auth, DeepL Key, 填写DeepL认证Key, 
1, 0, lyrics_translation, 歌词翻译, 翻译YouTube Music已返回的歌词；不改变歌曲信息, true, "[true, false]"
0, 0, external_subtitle_url, 外挂字幕URL, External模式使用；格式需与主轨相同, 


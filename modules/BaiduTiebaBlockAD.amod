[Module]
name = 百度贴吧去广告
description = 来源：@fmz200 · @app2smile ｜ 净化百度贴吧信息流、帖子及页面广告。
icon-light = 

[MITM]
# 百度贴吧去广告 - Anywhere MITM RuleSet
# 上游: fmz200/wool_scripts、app2smile/rules。

name = 百度贴吧去广告
hostname = tiebac.baidu.com, c.tieba.baidu.com

[Rule]
1, 100, ^http(?:s://tiebac|://c\.tieba)\.baidu\.com/(?:c/(?:s/sync|f/(?:ad/getSplashAd|frs/(?:page|threadlist|generalTabList)|pb/(?:pic)?page|excellent/personalized))$|tiebaads/commonbatch\?|c/(?:b/ad/adBid|f/(?:frs/(?:page|threadlist|generalTabList)|ad/getFeedAd|pb/page|excellent/personalized))\?cmd), 

[Parameter]
1, 0, per_filter_video_thread, 推荐页不展示视频贴, 设为1时隐藏推荐页视频贴；默认0保留正常视频贴。, 0, "[0, 1]"

[Routing]
# 百度贴吧去广告 - Anywhere Routing RuleSet
# 上游: fmz200/wool_scripts、app2smile/rules。

name = 百度贴吧广告 IP 拒绝
routing = 2

0, 180.76.76.200/32

[Module]
name = 强化搜索
description = 来源：@chikacya ｜ 在百度搜索框输入搜索指令，跳转对应站点；默认转向 Google。
icon-light = 

[MITM]
# 强化搜索 - Anywhere MITM RuleSet
# 上游: 自行整理。

name = 强化搜索
hostname = www.baidu.com, m.baidu.com


name = Spotify解锁
hostname = spclient.wg.spotify.com, spclient.spotify.com, spotify.com

0, 2, ^https://[^/]+/user-customization-service/v1/customize(?:\?|$), if-none-match
0, 0, ^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:pendragon/|ad(?:[/?]|$)), 2, {}
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://((?:(?!platform=iphone).)*?)com:443(.*?)platform=iphone(.*)$, 0, https://$1com$2platform=ipad$3
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://(.*?)platform=iphone(.*?)com:443(.*)$, 0, https://$1platform=ipad$2com$3
0, 0, ^(?=https://(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)/(?:artistview/v1/artist|album-entity-view/v2/album)/)https://(.*?)platform=iphone(.*)$, 0, https://$1platform=ipad$2

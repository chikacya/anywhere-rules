[Module]
name = 微博与 VVebo 去广告净化
description = 来源：@fmz200 · @zmqcherish · @suiyuran · @chikacya ｜ 净化微博与 VVebo 的动态、信息流及页面推广。 可配置首页分组清理。 ｜ 补齐动态广告清理，恢复首页分组清理并减少无效处理。
icon-light = 

[MITM]
# 微博与 VVebo 去广告净化 - Anywhere MITM RuleSet
# 上游: fmz200/wool_scripts、zmqcherish/proxy-script、suiyuran/stash。

name = 微博去广告净化合并版
hostname = weibo.cn, weibo.com, uve.weibo.com, api-cloudim.api.weibo.com, card.weibo.com, weibocdn.com, weibomingzi.com, viber.com

[Parameter]
1, 0, MainTabFilter, 首页分组清理, 移除首页多余分组和全部微博入口, true, "[true, false]"

[Rule]

0, 2, ^https://[^/]+/(?:2/(?:statuses/user_timeline(?:\?|$)|profile/statuses/tab(?:\?|$)|cardlist(?:\?|$)|search/(?:finder|container_timeline|container_discover)(?:\?|$)|(?:page|flowpage)\?|searchall\?|statuses/(?:container_timeline_topicpage|container_timeline_topic|extend|container_detail|container_detail_comment|container_detail_mix|container_detail_forward)\?|comments/mix_comments\?|messageflow|statuses/(?:unread_)?friends(?:/|_)timeline(?:\?|$)|groups/timeline(?:\?|$)|statuses/(?:container_timeline|container_timeline_unread|container_timeline_hot|unread_hot_timeline|extend|video_mixtimeline)(?:\?|$)|profile/(?:me|container_timeline)(?:\?|$)|video/(?:community_tab|remind_info|tiny_stream_video_list)(?:\?|$)|checkin/show(?:\?|$)|(?:!/)?live/media_homelist(?:\?|$)|comments/build_comments(?:\?|$)|container/get_item(?:\?|$)|statuses/repost_timeline(?:\?|$)|!/client/light_skin(?:\?|$))|portal\.php\?a=trends&|interface/sdk/sdkad\.php(?:\?|$)|wbapplua/wbpullad\.lua(?:\?|$)|littleskin/preview(?:\?|$)|aj/appicon/list(?:\?|$)), if-none-match

[Module]
name = Apple WLOC 定位修改
description = 来源：@ios151 ｜ 修改 Apple 网络定位返回的位置，支持在线选点。 可配置经纬度、定位精度及随机扰动半径。
icon-light = 

[MITM]
# Apple WLOC 定位修改 - Anywhere MITM RuleSet
# 上游: Yu9191/wloc。

name = Apple WLOC 定位修改 Arg
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

[Parameter]
0, 0, longitude, 经度, 默认经度。在线选点保存的坐标优先于此参数。, 113.94114
0, 0, latitude, 纬度, 默认纬度。在线选点保存的坐标优先于此参数。, 22.544577
0, 0, accuracy, 精度, 定位精度，单位米。, 25
0, 0, randomRadius, 扰动半径, 每次响应在目标点周围随机偏移的最大距离，单位米；0 为关闭。, 0
1, 0, logLevel, 日志级别, 上游 wloc 日志级别。, info, "[info, off, error, warn, debug, all]"

[Rule]
0, 100, ^https?://gs-loc(-cn)?\.apple\.com/wloc-settings/save(?:\?|$), 
1, 100, ^https?://(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)/clls/wloc(?:\?|$), 

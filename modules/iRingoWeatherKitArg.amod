[Module]
name = iRingo WeatherKit
description = 来源：@VirgilClyne · @WordlessEcho · @001ProMax · @hhh2210 · @chikacya ｜ 调整 Apple 天气数据，补充预警、空气质量及短时降水。 可配置天气与预警数据源、空气质量算法及服务商令牌。 ｜ 按功能拆分处理，减少本地天气查询加载的无关代码。
icon-light = 

[MITM]
# iRingo WeatherKit - Anywhere MITM RuleSet
# 上游: NSRingo/WeatherKit。

name = iRingo WeatherKit Arg
hostname = weatherkit.apple.com

[Parameter]
0, 0, data_sets, "[数据集]", "选择解析处理的数据集；空值不处理。", "airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts"
1, 0, weather_alerts_provider, "[天气预警] 数据源", 使用选定的数据源处理预警。, QWeatherWeb, "[QWeatherWeb, WeatherKit, QWeather, ColorfulClouds]"
1, 0, pollutants_provider, "[今日污染物] 数据源", 填补污染物数据。, ColorfulClouds, "[ColorfulClouds, QWeather]"
1, 0, weather_provider, "[天气] 数据源", 使用选定的数据源替换天气数据。, ColorfulClouds, "[ColorfulClouds, WeatherKit, QWeather]"
1, 0, next_hour_provider, "[未来一小时降水强度] 数据源", 使用选定的数据源填充未来一小时降水强度的数据。, ColorfulClouds, "[ColorfulClouds, WeatherKit, QWeather]"
1, 0, air_quality_algorithm, "[iRingo内置算法] 算法", 通过污染物数据本地计算空气指数。, EU_EAQI, "[EU_EAQI, None, UBA, WAQI_InstantCast_US, WAQI_InstantCast_CN, WAQI_InstantCast_CN_25_DRAFT, CA_AQHI, HK_AQHI, AQHI_Multi_CN, AQHI_Multi_CN_HK, CN_DEATH_AQHI, CN_DEATH_HK_AQHI]"
0, 0, colorfulclouds_token, "[API] 彩云天气令牌", "彩云天气 API 令牌。", 
0, 0, qweather_host, "[API] 和风天气主机", "和风天气 API 使用的主机名。", devapi.qweather.com
0, 0, qweather_token, "[API] 和风天气令牌", "和风天气 API 令牌。", 
0, 0, waqi_token, "[API] WAQI 令牌", "填写此字段将自动使用 WAQI 高级 API。", 
1, 0, log_level, "[调试] 日志等级", 选择脚本日志的输出等级。, WARN, "[WARN, OFF, ERROR, INFO, DEBUG, ALL]"

[Rule]
1, 100, ^https?://weatherkit\.apple\.com/api/v1/availability/, 
0, 100, ^https?://weatherkit\.apple\.com/api/v1/airQualityScale/, 
0, 100, "^https?://weatherkit\.apple\.com/api/v1/weatherAlerts\?[^#]*&ids=(?:[^&#]*-[0-9]{9}|-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?)(?:&|$)", 
1, 100, ^https?://weatherkit\.apple\.com/api/v2/weather/, 

[Routing]
# iRingo WeatherKit - Anywhere Routing RuleSet
# 上游: NSRingo/WeatherKit。

name = iRingo WeatherKit Reject
routing = 2
2, weather-analytics-events.apple.com
2, tthr.apple.com
2, tether.edge.apple
